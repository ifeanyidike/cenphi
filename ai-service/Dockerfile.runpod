# Application code moved to END for maximum cache efficiency
FROM --platform=linux/amd64 nvidia/cuda:12.1.1-devel-ubuntu20.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies (CACHED - rarely changes)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-dev python3.10-venv python3.10-distutils \
    curl wget git build-essential cmake pkg-config gfortran \
    libhdf5-dev libopenblas-dev liblapack-dev libffi-dev libssl-dev \
    libxml2-dev libxslt1-dev libjpeg-dev libpng-dev libtiff-dev \
    libwebp-dev zlib1g-dev libavcodec-dev libavformat-dev libswscale-dev \
    libswresample-dev libsndfile1-dev portaudio19-dev libasound2-dev \
    libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libgtk-3-dev

# Create venv (CACHED - rarely changes)
RUN python3.10 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements ONLY (CACHED unless requirements change)
COPY requirements-runpod.txt ./

# Install Python packages (CACHED unless requirements change)
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip \
    && pip install --no-cache-dir \
    torch==1.13.1+cu117 torchvision==0.14.1+cu117 torchaudio==0.13.1 \
    --extra-index-url https://download.pytorch.org/whl/cu117

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir \
    "numpy>=1.21.0,<1.25.0" \
    "scipy>=1.5.0,<1.16.0" \
    "pillow>=11.3.0,<12.0.0"

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir \
    transformers==4.53.0 \
    "opencv-python>=4.11.0.86,<5.0.0.0" \
    mediapipe==0.10.18

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir \
    runpod==1.7.13 \
    "openai>=1.93.0,<2.0.0" \
    "anthropic>=0.57.1,<0.58.0" \
    "elevenlabs>=2.6.0,<3.0.0" \
    "together>=1.5.19,<2.0.0"

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir \
    demucs==4.0.1 \
    "soundfile>=0.12.1,<0.13.0" \
    "librosa>=0.11.0,<0.12.0" \
    webrtcvad-wheels==2.0.14

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir \
    "oci>=2.155.0,<3.0.0" \
    "num2words>=0.5.14,<0.6.0" \
    "psutil>=5.9.0,<6.0.0" \
    "fastapi>=0.104.0" \
    "uvicorn[standard]>=0.24.0" \
    "pydantic==2.8.2" \
    "orjson>=3.9.0" \
    "python-multipart>=0.0.6"

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --no-deps \
    basicsr==1.4.2 \
    realesrgan==0.3.0 \
    gfpgan==1.3.8 \
    facexlib==0.3.0

# Production Runtime
FROM --platform=linux/amd64 nvidia/cuda:12.1.1-runtime-ubuntu20.04 AS production

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    ENV_MODE=production \
    LOG_LEVEL=INFO

# Install runtime deps (CACHED - rarely changes)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-distutils \
    curl wget \
    libglib2.0-0 libsm6 libxext6 libxrender1 libgl1-mesa-glx \
    libopenblas0 liblapack3 libhdf5-103 libgomp1 \
    libjpeg-turbo8 libjpeg8 libpng16-16 libtiff5 libwebp6 \
    libavcodec58 libavformat58 libswscale5 libswresample3 \
    libssl1.1 libffi7 libsndfile1 libportaudio2 libportaudiocpp0 \
    libasound2 libxml2 libxslt1.1 \
    libstdc++6 libgcc-s1

# Install FFmpeg (CACHED)
RUN mkdir -p /opt/ffmpeg/bin
COPY --from=mwader/static-ffmpeg:7.1.1 /ffmpeg /opt/ffmpeg/bin/ffmpeg
COPY --from=mwader/static-ffmpeg:7.1.1 /ffprobe /opt/ffmpeg/bin/ffprobe
RUN chmod +x /opt/ffmpeg/bin/ffmpeg /opt/ffmpeg/bin/ffprobe
ENV PATH="/opt/ffmpeg/bin:$PATH"

# Copy Python environment (CACHED unless requirements change)
COPY --from=builder /opt/venv /opt/venv

# Setup directories (CACHED)
WORKDIR /app
RUN mkdir -p src storage logs models oci-secrets

# Environment variables (CACHED)
ENV AI_MODELS_DIR=/models \
    GFPGAN_CACHE_DIR=/app/gfpgan \
    BASICSR_CACHE_DIR=/app/models/enhancement \
    FACEXLIB_CACHE_DIR=/app/gfpgan/weights \
    TORCH_HOME=/models/torch \
    HF_HOME=/models/huggingface \
    WHISPER_CACHE=/models/whisper \
    NLTK_DATA=/models/nltk_data \
    CUDA_VISIBLE_DEVICES=0 \
    PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128 \
    OMP_NUM_THREADS=4 \
    TOKENIZERS_PARALLELISM=false \
    PYTORCH_JIT=0

# Create model directories (CACHED)
RUN mkdir -p /app/gfpgan/weights \
    /app/models/enhancement \
    /models/torch \
    /models/huggingface \
    /models/whisper \
    /models/nltk_data \
    /models/scene_analysis \
    /models/audio_separation \
    && chmod -R 755 /app/gfpgan /app/models

# Copy scripts (CACHED unless scripts change)
COPY scripts/preload_models.py ./scripts/
RUN chmod +x scripts/preload_models.py

# Verify FFmpeg xfade filter (CACHED - before app code)
RUN /opt/ffmpeg/bin/ffmpeg -f lavfi -i testsrc -vf "xfade=transition=fade:duration=1" -t 0.1 -f null - 2>/dev/null && echo "✅ xfade filter working" || echo "❌ xfade filter not available"

# Verification step (CACHED - before app code to maintain cache efficiency)
RUN python -c "import sys, torch, cv2, mediapipe, runpod, fastapi; print(f'✅ Python {sys.version_info.major}.{sys.version_info.minor}, PyTorch {torch.__version__}, CUDA: {torch.cuda.is_available()}, All libraries OK')"

# CRITICAL: Copy application code LAST (this is the only layer that rebuilds for code changes)
COPY main.py ./
COPY runpod_handler.py ./
COPY src/ ./src/

# Set permissions
RUN chmod -R 755 /app /models

CMD ["python", "-u", "runpod_handler.py"]